# Supabase — https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (Phase 2) — e.g. OpenAI
OPENAI_API_KEY=
# Or point to a one-line file (useful if keys live outside .env.local):
# OPENAI_API_KEY_FILE=password, do not read/openai-api-key.txt

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin ingest (generate a random string; required for POST /api/admin/ingest)
INGEST_SECRET=
